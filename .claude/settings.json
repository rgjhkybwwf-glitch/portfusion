{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(source .venv/bin/activate)",
      "Bash(python3 -m pytest:*)",
      "Bash(portfusion record)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git ls-files:*)"
    ],
    "deny": [
      "Bash(git push *--force)",
      "Bash(git push *--force *)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n *)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete main*)",
      "Bash(git push * -d main*)",
      "Bash(git push * :main*)",
      "Bash(*MAIN_REWRITE*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/stop_hook.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
