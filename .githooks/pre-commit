#!/usr/bin/env python3
"""THIS CHECKOUT'S SECRET GATE: `portfusion/hooks/pre_commit.py`, run from this checkout's own
`src/`, so a commit is checked by the code it commits and the gate runs before anything is
installed. The gate's docstring says what it refuses. Held by tests/test_hooks.py.

Committing this checkout, it then checks the import contracts and the types (`pyproject.toml`)
with the checkout's own venv, as CI does; a venv without a tool is warned of, and CI still checks.
"""
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))
from portfusion.hooks.pre_commit import main  # noqa: E402 — the checkout's own app
from portfusion.log import log  # noqa: E402


#: Each dev tool the gate runs from .venv: its arguments, and what its failure means.
TOOLS = (("lint-imports", ["--no-cache", "--no-logo"], "An import breaks a contract"),
         ("pyright", ["--pythonpath", str(ROOT / ".venv" / "bin" / "python3")],
          "A type does not check in a package pyright holds"))


def dev_tools() -> int:
    code = 0
    for name, args, refused in TOOLS:
        tool = ROOT / ".venv" / "bin" / name
        if not tool.exists():
            log.warning(f"pre-commit: {name} did not run: .venv has no {name} "
                        "(CONTRIBUTING.md, Setting up)")
            continue
        run = subprocess.run([str(tool), *args], cwd=ROOT, capture_output=True, text=True)
        if run.returncode:
            log.error(f"{run.stdout}{run.stderr}pre-commit: REFUSED. {refused} in pyproject.toml.")
            code = run.returncode
    return code


if __name__ == "__main__":
    code = main(sys.argv[1:])
    if not code and not sys.argv[1:] and pathlib.Path.cwd().resolve() == ROOT:
        code = dev_tools()
    sys.exit(code)
