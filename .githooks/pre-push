#!/usr/bin/env python3
"""THIS CHECKOUT'S GUARD ON MAIN: `portfusion/hooks/pre_push.py`, run from this checkout's own
`src/`, so a push is checked before anything is installed. The guard's docstring says what it
refuses; pushing this checkout, it also runs the leak test on the named book. Held by
tests/test_hooks.py.
"""
from __future__ import annotations

import pathlib
import sys

# A PYTHON TOO OLD TO IMPORT THE APP: a terminal without the venv, or a GUI git client, finds
# macOS's own python3 first. Refused with the fix, not a traceback.
if sys.version_info < (3, 13):
    sys.exit(f"{pathlib.Path(__file__).name}: REFUSED. It needs Python 3.13 or newer, and found "
             f"{sys.version.split()[0]}: activate the checkout's .venv (docs/environment.md).")

ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))
from portfusion.hooks.pre_push import main  # noqa: E402 — the checkout's own app

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], sys.stdin.read().splitlines(),
                  checkout=ROOT if pathlib.Path.cwd().resolve() == ROOT else None))
